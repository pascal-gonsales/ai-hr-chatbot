# Supabase project URL and keys. Get these from your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Anthropic API key for the Claude-powered chat agent.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Public access-request form is fail-closed by default. Set to 1 to open it
# (only once the form is fronted by a CAPTCHA and edge rate limiting).
PUBLIC_ACCESS_REQUEST_ENABLED=0
